# Approximates the Barr Group Embedded C Coding Standard (Barr-C:2018).
#
# This file covers only what a formatter can enforce. The standard's naming and
# typing rules are applied by hand in the sources: g_ prefix for file-scope
# variables (7.1.c), p_ prefix for pointers (7.1.e), and fixed-width integer
# types such as int16_t in place of int/short/long (5.1.a).
---
Language: Cpp
BasedOnStyle: LLVM

# 1.3.a: 80-character lines. 1.4: four spaces of indent, never tabs.
ColumnLimit: 80
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4

# 4.3.a: each brace sits on a line of its own, aligned with its keyword.
BreakBeforeBraces: Allman

# 4.3.b: braces are mandatory, so no body may collapse onto one line.
InsertBraces: true
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# 4.2.a: if/while/for/switch/return take one trailing space. Function names
# do not, so `if (x)` but `foo(x)`.
SpaceBeforeParens: ControlStatements

# 4.3.c: case labels indent one level inside their switch.
IndentCaseLabels: true

# 3.x: aligned columns in runs of declarations, assignments and #defines.
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments: true
AlignArrayOfStructures: Left

# 5.3: the asterisk stands between type and name - `char * p_name`.
PointerAlignment: Middle
DerivePointerAlignment: false
SpaceAfterCStyleCast: false

# Preprocessor directives stay in column 1; include grouping is deliberate.
IndentPPDirectives: None
SortIncludes: false

# Traditional C braced initialisers, padded inside the braces.
Cpp11BracedListStyle: false

ReflowComments: true
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
